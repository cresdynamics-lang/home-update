# Set to the public GTM container ID after the owner grants access.
NEXT_PUBLIC_GTM_ID=
# Meta Pixel ID. Leave blank until supplied by the owner.
NEXT_PUBLIC_META_PIXEL_ID=
# WhatsApp destination in international digits, without + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=254743844362
# Optional HTML meta token for Search Console URL-prefix property verification.
NEXT_PUBLIC_GSC_VERIFICATION=

# Admin login credentials: set privately in the deployment environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random session-signing key, at least 32 characters. Never reuse ADMIN_PASSWORD.
ADMIN_SECRET_KEY=
# Writable persistent volume path for catalog edits (required for durable production edits).
CATALOG_DATA_PATH=
# Writable persistent volume path for the private, admin-entered sales ledger.
SALES_DATA_PATH=
